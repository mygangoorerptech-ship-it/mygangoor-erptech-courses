# ─────────────────────────────────────────────────────────────────────────────
# ECA Backend — Environment Variable Reference
# Copy this file to .env and fill in real values. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development          # Required. "development" or "production"
PORT=5004

# ── Database ─────────────────────────────────────────────────────────────────
MONGO_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Use strong 256-bit random values. Access and refresh MUST differ.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=<strong-random-secret>
JWT_REFRESH_SECRET=<different-strong-random-secret>
JWT_MFA_SECRET=<strong-random-secret-for-mfa-temp-tokens>

# ── Token TTLs ────────────────────────────────────────────────────────────────
# REFRESH_TTL is the single source of truth for refresh-token lifetime.
# It controls JWT expiry, DB expiry, and cookie maxAge simultaneously.
# Supported units: s (seconds), m (minutes), h (hours), d (days)
ACCESS_TTL=90s
REFRESH_TTL=30d

# ── MFA ───────────────────────────────────────────────────────────────────────
JWT_MFA_SECRET=<strong-random-secret>
MFA_ENC_KEY=<base64url-encoded-32-byte-key>  # AES-256-GCM key for TOTP secret encryption
TOTP_ISSUER=ECA

# ── CORS + Cookies ────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (exact match).
# Dev (HTTP):        CORS_ORIGIN=http://localhost:5173  CROSS_SITE=0
# Dev (HTTPS certs): CORS_ORIGIN=https://localhost:5173  CROSS_SITE=1
# Production:        CORS_ORIGIN=https://your-frontend.vercel.app  CROSS_SITE=1
CORS_ORIGIN=http://localhost:5173
CROSS_SITE=0    # Set to 1 only when frontend and backend are on different domains (e.g. Vercel ↔ Render)

# ── Proxy ────────────────────────────────────────────────────────────────────
TRUST_PROXY=1   # Required when running behind Nginx, Cloudflare, or Render reverse proxy

# ── Public URL ───────────────────────────────────────────────────────────────
PUBLIC_APP_URL=http://localhost:5173   # Used in email links. Must match frontend URL.

# ── Debug Flags ───────────────────────────────────────────────────────────────
# NEVER set these to "1" in production — the startup guards will reject the boot.
DEBUG_AUTH=0    # When 1: logs cookie details. Never exposes tokens.
DEBUG_MFA=0     # When 1: logs MFA verification details.
DEBUG_STUDENT=0 # When 1: logs all /api/student/* request headers and cookies.

# ── Admin Bootstrap ───────────────────────────────────────────────────────────
# Used only for the initial superadmin seed. Remove after first deploy.
# Do NOT store plaintext passwords in production env files.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=<remove-after-first-run>

# ── Email ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=<your-resend-api-key>
EMAIL_FROM=ECA Academy <noreply@yourdomain.com>
CONTACT_ADMIN_EMAILS=admin@yourdomain.com

# ── Payments ─────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=<razorpay-key-id>
RAZORPAY_KEY_SECRET=<razorpay-key-secret>
RAZORPAY_WEBHOOK_SECRET=<razorpay-webhook-secret>

# ── Storage ───────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
CLOUDINARY_AUTH_TOKEN_KEY=<auth-token-key>
CLOUDINARY_NOTES_ACCESS=authenticated
NOTES_SIGNED_TTL=3600
